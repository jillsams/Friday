# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# The app still runs with these left blank (demo answers +
# browser speech). Add keys when you want the real APIs.

# xAI (SpaceXAI) — https://console.x.ai/
# Used for the chat answer. If missing, Friday returns a labelled demo answer.
XAI_API_KEY=

# Optional. Current flagship chat model. Change if docs list a newer one.
XAI_MODEL=grok-4.7

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
# Used to speak the answer. If missing or the request fails, the browser
# falls back to speechSynthesis (built-in voices).
ELEVENLABS_API_KEY=

# Optional. Premade voice that works on the free plan for new accounts.
# Default is Eldrin (6WwXjDDEMyNmFG95zycZ). Do NOT use the old "George"
# id (JBFqnCBsd6RMkjVDRZzb) unless your account was created before March 2026.
# How to pick another: My Voices → three dots → Copy voice ID.
# Voice Library voices are not available via the API on the free plan.
ELEVENLABS_VOICE_ID=6WwXjDDEMyNmFG95zycZ

# Optional. Flash v2.5 is the model ElevenLabs documents for free-plan API use.
# Other free-plan-friendly ids: eleven_flash_v2, eleven_multilingual_v2
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Optional. Port the local server listens on.
PORT=3000
